# Virtual environment
venv/
.venv/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Jupyter
.ipynb_checkpoints/

# Data (raw/processed are generally large or regenerable — keep out of git)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
# Exception: small, canonical source datasets we want version-controlled as-is
!data/raw/cocomo_nasa.csv
!data/raw/desharnais.csv
# Exception: small cleaned datasets produced by src/preprocessing.py
!data/processed/cocomo_nasa_clean.csv
!data/processed/desharnais_clean.csv
# Exception: train/test splits produced by src/split_data.py
!data/processed/cocomo_nasa_train.csv
!data/processed/cocomo_nasa_test.csv
!data/processed/desharnais_train.csv
!data/processed/desharnais_test.csv

# Trained models (block .pkl by default — they're regenerable via
# src/train_models.py — but explicitly track the 8 models from Step 6
# since the app in a later step will load them directly)
models/*.pkl
!models/.gitkeep
!models/cocomo_nasa_linear_regression.pkl
!models/cocomo_nasa_random_forest.pkl
!models/cocomo_nasa_xgboost.pkl
!models/cocomo_nasa_svr.pkl
!models/desharnais_linear_regression.pkl
!models/desharnais_random_forest.pkl
!models/desharnais_xgboost.pkl
!models/desharnais_svr.pkl

# Environment / secrets
.env
.env.*

# OS junk
.DS_Store
Thumbs.db

# Editor junk
.vscode/
.idea/
*.swp
*.swo
*~
