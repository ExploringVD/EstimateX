# Virtual environment
venv/
.venv/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Jupyter
.ipynb_checkpoints/

# Data (raw/processed are generally large or regenerable — keep out of git)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
# Exception: small, canonical source datasets we want version-controlled as-is
!data/raw/cocomo_nasa.csv
!data/raw/desharnais.csv
# Exception: small cleaned datasets produced by src/preprocessing.py
!data/processed/cocomo_nasa_clean.csv
!data/processed/desharnais_clean.csv
# Exception: train/test splits produced by src/split_data.py
!data/processed/cocomo_nasa_train.csv
!data/processed/cocomo_nasa_test.csv
!data/processed/desharnais_train.csv
!data/processed/desharnais_test.csv

# Trained models
models/*.pkl
!models/.gitkeep

# Environment / secrets
.env
.env.*

# OS junk
.DS_Store
Thumbs.db

# Editor junk
.vscode/
.idea/
*.swp
*.swo
*~
